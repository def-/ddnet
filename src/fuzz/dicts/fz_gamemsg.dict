# Whisper/converse prefixes - CGameContext::Whisper is a headline target of this
# harness and had never executed once in the campaign before these existed.
w="/w "
whisper="/whisper "
c="/c "
converse="/converse "
# FindClientIdByName is an exact str_comp against these, set by the fixture.
fuzz0="fuzz0"
fuzz1="fuzz1"
quote="\""
esc="\\"

# Vote types. CGameContext::OnCallVoteNetMessage dispatches on a str_comp_nocase of the
# first string in Cl_CallVote and does nothing at all for anything else, so without these
# three literals the whole 587-edge function is one long fall-through.
vote_option="option"
vote_kick="kick"
vote_spectate="spectate"
# Values for the kick/spectate votes: str_toint of this is the victim's client id, and only
# the two fixture slots exist.
victim0="0"
victim1="1"
# Reasons that random_map/random_unfinished_map parse as star filters.
stars1="3"
stars2="1-5"
# Vote option descriptions the map's settings could have registered.
opt_changemap="Change Map"
opt_svmap="sv_map "
opt_random="random_map"
opt_randomunf="random_unfinished_map"

