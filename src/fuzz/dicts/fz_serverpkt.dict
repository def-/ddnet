# OnNetMsgInfo compares the client version FIRST and drops on mismatch, so nothing
# downstream (READY, ENTERGAME, map download) is reachable without one of these.
netversion6="0.6 626fce9a778df4d4"
netversion7="0.7 802f1be60a05665f"
# The password the fixture configures, and the rcon password.
password="fuzz"
rconpw="a"
crashmeplx="crashmeplx"
# CheckReservedSlotAuth splits the password on the first colon into key name and password.
reserved="admin:a"

# Extended messages are addressed by a version-3 UUID over the teeworlds namespace
# (uuid_manager.cpp:38), not by a small integer, so a mutation cannot find one. These are
# the ones a client sends. Without them NETMSG_CLIENTVER - and with it
# CGameContext::OnClientDDNetVersionKnown - is unreachable.
uuid_clientver="\x8c\x00\x13\x04\x84\x61\x3e\x47\x87\x87\xf6\x72\xb3\x83\x5b\xd4"
uuid_pingex="\xbc\xb4\x3b\xf5\x42\x7c\x36\xd8\xb5\xb8\x79\x75\xc8\xc0\x6a\xa1"
uuid_whatis="\x24\x5e\x50\x97\x9f\xe0\x39\xd6\xbf\x7d\x9a\x29\xe1\x69\x1e\x4c"
uuid_itis="\x69\x54\x84\x7e\x2e\x87\x36\x03\xb5\x62\x36\xda\x29\xed\x1a\xca"
uuid_showothers="\x7f\x26\x4c\xdd\x71\xa2\x39\x62\xbb\xce\x0f\x94\xbb\xd8\x19\x13"

