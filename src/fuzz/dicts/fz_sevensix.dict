# The 17 STANDARD_SKINS names (teeinfo.cpp:15-34). ToSixup only copies a standard skin`s
# parts when m_aSkinName compares EQUAL to one of these, and FromSixup only takes its
# early return when all six part names match one entry - neither is reachable by random
# mutation, so the exact strings have to be in the dictionary.
s_default="default"
s_bluekitty="bluekitty"
s_bluestripe="bluestripe"
s_brownbear="brownbear"
s_cammo="cammo"
s_cammostripes="cammostripes"
s_coala="coala"
s_limekitty="limekitty"
s_pinky="pinky"
s_redbopp="redbopp"
s_redstripe="redstripe"
s_saddo="saddo"
s_toptri="toptri"
s_twinbop="twinbop"
s_twintri="twintri"
s_warpaint="warpaint"
s_greensward="greensward"
# Every distinct skin PART name in the same table - these are what FromSixup compares.
p_standard="standard"
p_kitty="kitty"
p_whisker="whisker"
p_negative="negative"
p_stripes="stripes"
p_stripe="stripe"
p_bear="bear"
p_hair="hair"
p_cammo2="cammo2"
p_cammostripes="cammostripes"
p_koala="koala"
p_twinbelly="twinbelly"
p_donny="donny"
p_unibop="unibop"
p_duodonny="duodonny"
p_twinbopp="twinbopp"
p_saddo="saddo"
p_toptri="toptri"
p_twintri="twintri"
p_warpaint="warpaint"
p_greensward="greensward"
# Packed HSL colours from the table, little-endian, so a mutation can line one up exactly.
c_default_body="\x74\x71\x1b\x00"
c_default_hands="\x9e\x77\x1b\x00"
c_default_feet="\x3e\x87\x1c\x00"
c_marking_white="\xff\xff\xff\x22"
# Boundaries for the colour arithmetic and the table lookups.
i_min="\x00\x00\x00\x80"
i_max="\xff\xff\xff\x7f"
i_neg1="\xff\xff\xff\xff"
